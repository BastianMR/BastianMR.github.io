---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  kicker?: string;
  class?: string;
};

const { pageTitle, pageDesc, kicker, class: className } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pb-4", className]}
>
  <header class="pt-10 pb-8">
    <p
      class="text-muted-foreground text-[0.6875rem] tracking-[0.18em] uppercase"
    >
      <span class="text-accent" aria-hidden="true">{"// "}</span>
      {kicker ?? t.hud.kicker}
    </p>
    <h1
      class="mt-3 text-2xl leading-[1.15] font-bold tracking-[-0.02em] sm:text-[2rem]"
    >
      {pageTitle}<span
        aria-hidden="true"
        class="bg-accent animate-caret ml-1.5 inline-block h-[0.95em] w-[0.6em] align-[-0.08em] motion-reduce:hidden"
      ></span>
    </h1>
    {
      pageDesc && (
        <p class="mt-3.5 max-w-[38rem] text-[0.9375rem] leading-relaxed">
          {pageDesc}
        </p>
      )
    }
  </header>
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
