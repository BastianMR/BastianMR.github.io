---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { entryFilter } from "@/utils/entryFilter";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// Rail entries, in reading order. Search keeps /search/ reachable from every
// page; archives only exist when the feature is enabled.
const railItems = [
  { path: "posts", label: t.nav.posts },
  { path: "noticias", label: t.nav.news },
  { path: "proyectos", label: t.nav.projects },
  { path: "tags", label: t.nav.tags },
  { path: "about", label: t.nav.about },
  ...(features.search !== false
    ? [{ path: "search", label: t.nav.search }]
    : []),
  ...(features.showArchives
    ? [{ path: "archives", label: t.nav.archives }]
    : []),
];

// Published post counter for the status bar.
const publishedPosts = await getCollection("posts", entryFilter);
const publishedCount = publishedPosts.length;

const padNumber = (value: number) => String(value).padStart(2, "0");
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="hud-bar bg-background border-border sticky top-0 z-10 h-(--bar-h) border-b"
>
  <div class="flex h-full items-center justify-between gap-4 px-4 sm:px-6">
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="group flex items-center gap-2.5 text-[0.9375rem] leading-none font-semibold tracking-[-0.01em] whitespace-nowrap sm:text-[1.0625rem]"
    >
      <img
        src="/images/eastereggs/hi.png"
        alt="Caballero de Guardian Tales saludando"
        class="pixel-sprite h-[22px] w-auto group-hover:animate-bounce motion-reduce:group-hover:animate-none"
        width="44"
        height="54"
      />
      {site.title}
    </a>
    <div class="flex items-center gap-3">
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="focus-outline hover:[&>svg]:stroke-accent relative size-8"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
      <div
        class="flex items-center gap-3 text-xs tracking-[0.14em] whitespace-nowrap uppercase"
      >
        <span class="text-accent inline-flex items-center gap-2 font-semibold">
          <span
            aria-hidden="true"
            class="bg-accent size-1.5 animate-pulse motion-reduce:animate-none"
          ></span>
          <span class="max-[379px]:sr-only">{t.hud.online}</span>
        </span>
        <span aria-hidden="true" class="text-border hidden sm:inline">|</span>
        <span class="text-muted-foreground hidden sm:inline">
          {publishedCount}{" "}{t.hud.posts}
        </span>
      </div>
    </div>
  </div>
</header>

<nav
  aria-label={t.hud.index}
  class="hud-rail bg-background border-border flex flex-wrap items-center gap-x-5 border-b px-4 py-2 min-[901px]:fixed min-[901px]:start-0 min-[901px]:top-(--bar-h) min-[901px]:bottom-0 min-[901px]:w-(--rail-w) min-[901px]:flex-col min-[901px]:items-stretch min-[901px]:gap-0 min-[901px]:overflow-y-auto min-[901px]:border-e min-[901px]:border-b-0 min-[901px]:px-6 min-[901px]:pt-7 min-[901px]:pb-5"
>
  <p
    aria-hidden="true"
    class="text-muted-foreground mb-3 hidden ps-0 pe-2 text-[0.625rem] tracking-[0.22em] uppercase min-[901px]:block"
  >
    {t.hud.index}
  </p>
  <ol
    class="flex flex-wrap items-center gap-x-1 gap-y-1 min-[901px]:w-full min-[901px]:flex-col min-[901px]:flex-nowrap"
  >
    {
      railItems.map((item, index) => {
        const active = isActive(`/${item.path}`);
        return (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, item.path)}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex items-baseline gap-2 border-s-2 py-2 ps-1.5 pe-2 text-sm leading-snug transition-colors",
                active
                  ? "border-accent bg-muted text-accent"
                  : "hover:bg-muted hover:text-accent border-transparent",
              ]}
            >
              <span
                class:list={[
                  "w-4 shrink-0 text-[0.6875rem] tracking-[0.08em] tabular-nums",
                  active ? "text-accent" : "text-muted-foreground",
                ]}
              >
                {padNumber(index + 1)}
              </span>
              {active && (
                <img
                  src="/images/eastereggs/attack.png"
                  alt=""
                  aria-hidden="true"
                  class="pixel-sprite ms-auto hidden h-[18px] w-auto self-center min-[901px]:block"
                  width="49"
                  height="41"
                />
              )}
              <span>{item.label}</span>
            </a>
          </li>
        );
      })
    }
  </ol>
</nav>

<script>
  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
