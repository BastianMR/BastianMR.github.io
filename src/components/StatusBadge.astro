---
import type { ProjectStatus } from "@/content.config";
import { useTranslations } from "@/i18n";

type Props = {
  status: ProjectStatus;
};

const { status } = Astro.props;

const t = useTranslations(Astro.currentLocale);

// Every tone is derived from existing tokens; no new colors.
const tone: Record<ProjectStatus, string> = {
  "en-curso": "border-accent/60 text-accent",
  pausado: "border-border text-muted-foreground",
  terminado: "border-foreground/40 text-foreground",
  abandonado: "border-border text-muted-foreground line-through",
  idea: "border-border border-dashed text-muted-foreground",
};
---

<span
  class:list={[
    "inline-flex items-center border px-2 py-0.5 text-[0.625rem] tracking-[0.14em] uppercase",
    tone[status],
  ]}
>
  {t.projects.status[status]}
</span>
