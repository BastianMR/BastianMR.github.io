---
import { getEntryUrl } from "@/utils/getEntryPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import type { ContentEntry } from "@/utils/content";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & ContentEntry;

const { variant: Heading = "h2", collection, id, data, filePath } = Astro.props;

const { title, description, pubDatetime, modDatetime, timezone } = data;
---

<li class="my-6">
  <a
    href={getEntryUrl(collection, id, filePath, Astro.currentLocale)}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading transition:name={toTransitionName(id)}>
      {title}
    </Heading>
  </a>
  <Datetime {pubDatetime} {modDatetime} {timezone} />
  <p>{description}</p>
</li>
