---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import BackButton from "@/components/BackButton.astro";
import BackToTopButton from "@/components/BackToTopButton.astro";
import AdjacentPostNav from "@/components/AdjacentPostNav.astro";
import ArticleScripts from "@/components/ArticleScripts.astro";
import { getEntrySlug, getEntryUrl } from "@/utils/getEntryPaths";
import { getSortedEntries } from "@/utils/getSortedEntries";
import { getNewsCategoryLabel } from "@/content.config";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths() {
  const news = await getCollection("news");
  const sortedNews = getSortedEntries(news);

  return sortedNews.map((entry, index) => ({
    params: {
      slug: getEntrySlug(entry.collection, entry.id, entry.filePath),
    },
    props: {
      entry,
      // sortedNews is newest-first, so "older" (prev) is a higher index
      // and "newer" (next) is a lower index.
      prevNews:
        index < sortedNews.length - 1
          ? {
              id: sortedNews[index + 1].id,
              title: sortedNews[index + 1].data.title,
              filePath: sortedNews[index + 1].filePath,
            }
          : null,
      nextNews:
        index > 0
          ? {
              id: sortedNews[index - 1].id,
              title: sortedNews[index - 1].data.title,
              filePath: sortedNews[index - 1].filePath,
            }
          : null,
    },
  }));
}

type AdjacentNews = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  entry: CollectionEntry<"news">;
  prevNews: AdjacentNews;
  nextNews: AdjacentNews;
};

const { entry, prevNews, nextNews } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  category,
  source,
} = entry.data;

const { Content } = await render(entry);

const categoryName = getNewsCategoryLabel(category);

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && config.features.dynamicOgImage) {
  const entryUrl = getEntryUrl(
    entry.collection,
    entry.id,
    entry.filePath,
    locale
  ).replace(/\/+$/, "");
  ogImageUrl = `${entryUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  {description}
  {ogImage}
  {canonicalURL}
  {pubDatetime}
  {modDatetime}
>
  <Header />

  <BackButton />

  <main
    id="main-content"
    class:list={["app-layout", { "mt-8": !config.features.showBackButton }]}
    data-pagefind-body
  >
    <h1
      style={{ viewTransitionName: toTransitionName(entry.id) }}
      class="text-accent inline-block text-2xl font-bold sm:text-3xl"
    >
      {title}
    </h1>

    <div class="my-2 flex flex-wrap items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span aria-hidden="true" class="text-muted-foreground">|</span>
      <a
        href={getRelativeLocaleUrl(locale, `noticias/categoria/${category}`)}
        class="text-muted-foreground hover:text-hover underline decoration-dashed underline-offset-4"
      >
        {t.news.categoryLabel}: {categoryName}
      </a>
    </div>

    <p class="mt-3 flex flex-wrap items-center gap-2">
      <span class="text-muted-foreground">{t.news.sourceLabel}:</span>
      <a
        href={source.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent underline decoration-dashed underline-offset-4 hover:no-underline"
      >
        {source.name}
      </a>
    </p>

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    <hr class="my-8 border-dashed" />

    <BackToTopButton />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <ShareLinks />

    <hr class="my-8 border-dashed" />

    <AdjacentPostNav
      prevPost={prevNews}
      nextPost={nextNews}
      collection="news"
    />
  </main>
  <Footer />
</PostLayout>

<ArticleScripts />
