---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedEntries } from "@/utils/getSortedEntries";
import { slugifyAll } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const [posts, news] = await Promise.all([
    getCollection("posts", ({ data }) => !data.draft),
    getCollection("news", ({ data }) => !data.draft),
  ]);
  // Posts and news share one tag namespace, so a tag page lists both.
  const entries = [...posts, ...news];
  const tags = getUniqueTags(entries);

  return tags.flatMap(({ tag, tagName }) => {
    const tagEntries = getSortedEntries(
      entries.filter(({ data }) => slugifyAll(data.tags).includes(tag))
    );

    return paginate(tagEntries, {
      params: { tag },
      props: { tagName },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, tagName } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagTitle}: ${tagName} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={`${t.pages.tagTitle}: ${tagName}`}
    pageDesc={`${t.pages.tagDesc} "${tagName}".`}
  >
    <ul>
      {page.data.map(entry => <Card {...entry} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
