---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedEntries } from "@/utils/getSortedEntries";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig, news: newsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedEntries(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const newsEntries = await getCollection("news");
const recentNews = getSortedEntries(newsEntries).slice(0, newsConfig.perIndex);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout title="Bastian Marquez Riffo — IA, Finanzas y Código">
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="pt-10 pb-8" aria-labelledby="hero-title">
      <p
        class="text-muted-foreground text-[0.6875rem] tracking-[0.18em] uppercase"
      >
        <span class="text-accent" aria-hidden="true">{"// "}</span>
        {t.hud.kicker}
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
        <h1
          id="hero-title"
          class="inline-block text-2xl leading-[1.15] font-bold tracking-[-0.02em] sm:text-[2rem]"
        >
          IA, Finanzas y Código<span
            aria-hidden="true"
            class="bg-accent animate-caret ml-1.5 inline-block h-[0.95em] w-[0.6em] align-[-0.08em] motion-reduce:hidden"
          ></span>
        </h1>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="text-accent hover:text-hover inline-flex items-center"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>

      <p class="mt-3.5 max-w-[38rem] text-[0.9375rem] leading-relaxed">
        Blog de <strong>Bastian Marquez Riffo</strong>
        <em>(Tweakers_BAMR)</em>
        — AI-Driven Finance &amp; Operations Specialist. Experimentos con IA, finanzas,
        proyectos de código y lecciones de la vida real.
      </p>
      <p class="mt-2 max-w-[38rem] text-[0.9375rem] leading-relaxed">
        Leé los posts, revisa{" "}
        <LinkButton
          class="hover:text-hover underline decoration-dashed underline-offset-4"
          href="/about"
        >
          quién está detrás
        </LinkButton>{" "}
        o suscribite al RSS.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="text-muted-foreground me-2 mb-1 text-xs tracking-[0.14em] whitespace-nowrap uppercase sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class:list={["pt-4 pb-6"]}>
          <div class="border-border flex items-center justify-between gap-4 border-b pb-2.5">
            <h2 class="text-muted-foreground text-[0.6875rem] font-semibold tracking-[0.18em] uppercase">
              {t.home.featured}
            </h2>
          </div>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-4 pb-6">
          <div class="border-border flex items-center justify-between gap-4 border-b pb-2.5">
            <h2 class="text-muted-foreground text-[0.6875rem] font-semibold tracking-[0.18em] uppercase">
              {t.home.recentPosts}
            </h2>
          </div>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentNews.length > 0 && (
        <section id="recent-news" class="pt-4 pb-6">
          <div class="border-border flex items-center justify-between gap-4 border-b pb-2.5">
            <h2 class="text-muted-foreground text-[0.6875rem] font-semibold tracking-[0.18em] uppercase">
              {t.home.recentNews}
            </h2>
          </div>
          <ul>
            {recentNews.map(entry => (
              <Card variant="h3" {...entry} />
            ))}
          </ul>
          <LinkButton href={getRelativeLocaleUrl(locale, "noticias")}>
            {t.home.allNews}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </section>
      )
    }

    <div class="my-8 flex items-center justify-center gap-3">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <img
        src="/images/eastereggs/attack.png"
        alt="Caballero de Guardian Tales corriendo con la espada levantada"
        class="pixel-sprite h-9 w-auto hover:animate-bounce motion-reduce:hover:animate-none"
        width="49"
        height="41"
        loading="lazy"
        title="🤫"
      />
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
